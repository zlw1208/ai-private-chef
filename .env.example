# Application
APP_NAME=AI Private Chef
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000
API_PREFIX=/api
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

# Development defaults to SQLite. For PostgreSQL, replace this with a
# postgresql+psycopg://user:password@host:5432/database URL.
DATABASE_URL=sqlite+aiosqlite:///./data/ai_private_chef.db
CHECKPOINTER_BACKEND=sqlite
CHECKPOINT_SQLITE_PATH=./data/checkpoints.sqlite

# Qwen through Alibaba Cloud Model Studio's OpenAI-compatible API.
# The default base URL below is for China (Beijing). API keys are region-specific.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
QWEN_REASONING_EFFORT=none
QWEN_IMAGE_MAX_PIXELS=8388608

# External services
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-private-chef-dev
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# Alibaba Cloud OSS
OSS_REGION=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_UPLOAD_URL_TTL_SECONDS=900
OSS_DOWNLOAD_URL_TTL_SECONDS=300
OSS_MAX_IMAGE_SIZE_BYTES=10485760
