# Copy this file to .env.production and fill every secret before deployment.
APP_NAME=AI Private Chef
APP_LOG_LEVEL=INFO
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

POSTGRES_DB=ai_private_chef
POSTGRES_USER=chef
POSTGRES_PASSWORD=replace-with-a-long-random-password

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
QWEN_REASONING_EFFORT=none
TAVILY_API_KEY=

LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ai-private-chef-production
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

OSS_REGION=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_UPLOAD_URL_TTL_SECONDS=900
OSS_DOWNLOAD_URL_TTL_SECONDS=300
OSS_MAX_IMAGE_SIZE_BYTES=10485760
